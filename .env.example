# Application
NODE_ENV=development
PORT=3000
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# PostgreSQL (replace credentials and database name for your environment)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credit_decisioning?schema=public"

# Development seed data only — do not use these credentials outside local development.
SEED_TENANT_NAME="Development Tenant"
SEED_TENANT_SLUG="development"
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_NAME="Development Admin"
SEED_ADMIN_PASSWORD="change-me-in-development"

# Optional: only required by POST /ai-evaluate. The deterministic /evaluate route never uses it.
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
