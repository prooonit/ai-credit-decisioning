generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS
  OTHER
}

enum LoanType {
  PERSONAL
  BUSINESS
  VEHICLE
}

enum ApplicationStatus {
  DRAFT
  PENDING
  EVALUATING
  APPROVED
  REJECTED
  MANUAL_REVIEW
  FAILED
}

enum CreditPolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CreditDecisionOutcome {
  APPROVED
  REJECTED
  MANUAL_REVIEW
}

enum BankAccountType {
  SAVINGS
  CURRENT
}

enum BankTransactionType {
  CREDIT
  DEBIT
}

enum TransactionCategory {
  SALARY
  RENT
  EMI
  UTILITY
  FOOD
  TRANSFER
  OTHER
}

enum LiabilityType {
  PERSONAL_LOAN
  HOME_LOAN
  AUTO_LOAN
  CREDIT_CARD
  OTHER
}

enum LiabilityStatus {
  ACTIVE
  CLOSED
  DEFAULTED
}

enum IdentityVerificationStatus {
  VERIFIED
  FAILED
  PENDING
}

model Tenant {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                 @unique
  status                TenantStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customers             Customer[]
  applications          LoanApplication[]
  creditProfiles        CreditProfile[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  liabilities           Liability[]
  identityVerifications IdentityVerification[]
  creditPolicies        CreditPolicy[]
  creditDecisions       CreditDecision[]

  // All tenant-owned models should reference this model through a tenantId UUID.
  memberships UserTenantMembership[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserTenantMembership[]

  @@unique([email])
}

model UserTenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  externalReference String?
  fullName          String
  dateOfBirth       DateTime
  employmentType    EmploymentType
  monthlyIncome     Decimal        @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications          LoanApplication[]
  creditProfile         CreditProfile?
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  liabilities           Liability[]
  identityVerifications IdentityVerification[]

  @@unique([tenantId, externalReference])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model CreditProfile {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  customerId       String   @unique @db.Uuid
  creditScore      Int
  totalAccounts    Int
  activeAccounts   Int
  totalOutstanding Decimal  @db.Decimal(15, 2)
  latePayments     Int
  hardInquiries    Int
  creditAgeMonths  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model BankAccount {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @db.Uuid
  customerId          String            @db.Uuid
  institutionName     String
  accountType         BankAccountType
  maskedAccountNumber String
  currentBalance      Decimal           @db.Decimal(15, 2)
  availableBalance    Decimal           @db.Decimal(15, 2)
  openedAt            DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions        BankTransaction[]

  @@index([tenantId, customerId])
}

model BankTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  bankAccountId   String              @db.Uuid
  customerId      String              @db.Uuid
  transactionDate DateTime
  type            BankTransactionType
  amount          Decimal             @db.Decimal(15, 2)
  category        TransactionCategory
  description     String
  balanceAfter    Decimal             @db.Decimal(15, 2)
  createdAt       DateTime            @default(now())
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, transactionDate])
  @@index([tenantId, bankAccountId])
}

model Liability {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  customerId        String          @db.Uuid
  type              LiabilityType
  lenderName        String
  originalAmount    Decimal         @db.Decimal(15, 2)
  outstandingAmount Decimal         @db.Decimal(15, 2)
  monthlyEmi        Decimal         @db.Decimal(15, 2)
  interestRate      Decimal         @db.Decimal(5, 2)
  startDate         DateTime
  endDate           DateTime?
  status            LiabilityStatus
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model IdentityVerification {
  id         String                     @id @default(uuid()) @db.Uuid
  tenantId   String                     @db.Uuid
  customerId String                     @db.Uuid
  status     IdentityVerificationStatus
  provider   String
  reference  String
  verifiedAt DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model LoanApplication {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  customerId      String            @db.Uuid
  loanType        LoanType
  requestedAmount Decimal           @db.Decimal(15, 2)
  status          ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creditDecision CreditDecision?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

model CreditPolicy {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  name          String
  version       Int
  status        CreditPolicyStatus @default(DRAFT)
  configuration Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions CreditDecision[]

  @@unique([tenantId, version])
  @@index([tenantId, status])
}

model CreditDecision {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  applicationId String                @unique @db.Uuid
  policyId      String                @db.Uuid
  policyVersion Int
  decision      CreditDecisionOutcome
  ruleResults   Json
  createdAt     DateTime              @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  policy      CreditPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([tenantId, applicationId])
  @@index([tenantId, createdAt])
}
