generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS
  OTHER
}

enum LoanType {
  PERSONAL
  BUSINESS
  VEHICLE
}

enum ApplicationStatus {
  DRAFT
  PENDING
  EVALUATING
  APPROVED
  REJECTED
  MANUAL_REVIEW
  FAILED
}

model Tenant {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  slug         String            @unique
  status       TenantStatus      @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  customers    Customer[]
  applications LoanApplication[]

  // All tenant-owned models should reference this model through a tenantId UUID.
  memberships UserTenantMembership[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserTenantMembership[]

  @@unique([email])
}

model UserTenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  externalReference String?
  fullName          String
  dateOfBirth       DateTime
  employmentType    EmploymentType
  monthlyIncome     Decimal        @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications LoanApplication[]

  @@unique([tenantId, externalReference])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model LoanApplication {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  customerId      String            @db.Uuid
  loanType        LoanType
  requestedAmount Decimal           @db.Decimal(15, 2)
  status          ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}
